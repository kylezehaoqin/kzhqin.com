---
import Base from "../layouts/Base.astro";
import { hasNotes } from "../lib/content";
const notes = await hasNotes();
---
<Base title="Not found" current="404">
  <main class="page lost">
    <span class="code">E404: page not found</span>
    <div class="page-h"><h1>Nothing at this address.</h1><p>The page moved, or it never existed.</p></div>
    <div class="links"><a class="btn primary nav-item" href="/">Go home</a>{notes
      ? <a class="btn nav-item" href="/notes">Read the notes</a>
      : <a class="btn nav-item" href="/projects">See projects</a>}</div>
  </main>
</Base>
