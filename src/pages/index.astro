---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import NoteRow from "../components/NoteRow.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import { getNotes, getProjects } from "../lib/content";

const all = await getProjects();
const projects = all.filter((p) => p.data.featured).slice(0, 4);
const notes = (await getNotes()).slice(0, 3);
---
<Base current="home">
  <main>
    <section class="hero">
      <span class="status"><i aria-hidden="true"></i>Open to full-stack roles · San Jose, CA</span>
      <h1>Hi, I'm Kyle.{" "}<span class="grad">I build full-stack apps for data-heavy problems.</span></h1>
      <p>I work end to end, from the database schema to the CI/CD infra. Lately that's been side projects: a tennis analytics text to SQL agent, a plant ID trainer for a botany exam, and a physics tool for racket nerds (I'm one of them).</p>
      <Contact />
    </section>

    <section class="sec" aria-labelledby="h-projects">
      <div class="sec-h"><h2 id="h-projects">projects</h2><a href="/projects">all {all.length} →</a></div>
      <ul class="rows">{projects.map((p) => <ProjectRow project={p} />)}</ul>
    </section>

    {notes.length > 0 && (
      <section class="sec" aria-labelledby="h-notes">
        <div class="sec-h"><h2 id="h-notes">notes</h2><a href="/notes">all →</a></div>
        <ul class="list">{notes.map((n) => <NoteRow note={n} />)}</ul>
      </section>
    )}

    <section class="sec" aria-labelledby="h-stack">
      <div class="sec-h"><h2 id="h-stack">stack</h2><a href="/about#stack">full list →</a></div>
      <Skills compact />
    </section>

    <section class="sec" aria-labelledby="h-about">
      <div class="sec-h"><h2 id="h-about">about</h2></div>
      <div class="about-strip">
        <p>Full-stack developer in San Jose. I studied computer science and web science at RPI, then built and ran production apps as a contractor for education and e-commerce clients.</p>
        <a class="nav-item" href="/about">Read more about me</a>
      </div>
    </section>
  </main>
</Base>
