---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import NoteRow from "../components/NoteRow.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import { getNotes, getProjects } from "../lib/content";

const all = await getProjects();
const projects = all.filter((p) => p.data.featured).slice(0, 4);
const notes = (await getNotes()).slice(0, 3);
---
<Base current="home">
  <main id="main">
    <section class="hero">
      <span class="status"><i aria-hidden="true"></i>Open to software roles · <span class="nw">Bay Area</span></span>
      <h1><span class="grad">Kyle Qin</span></h1>
      <p>Software engineer. I build full-stack applications and data systems, from the interface to the deploy pipeline.</p>
      <Contact />
    </section>

    <section class="sec" aria-labelledby="h-stack">
      <div class="sec-h"><h2 id="h-stack">stack</h2><a href="/about#stack">full list →</a></div>
      <Skills compact />
    </section>

    <section class="sec" aria-labelledby="h-xp">
      <div class="sec-h"><h2 id="h-xp">experience</h2><a href="/about">about me →</a></div>
      <Experience />
    </section>

    <section class="sec" aria-labelledby="h-projects">
      <div class="sec-h"><h2 id="h-projects">projects</h2><a href="/projects">all →</a></div>
      <ul class="rows">{projects.map((p) => <ProjectRow project={p} />)}</ul>
    </section>

    {notes.length > 0 && (
      <section class="sec" aria-labelledby="h-notes">
        <div class="sec-h"><h2 id="h-notes">notes</h2><a href="/notes">all →</a></div>
        <ul class="list">{notes.map((n) => <NoteRow note={n} />)}</ul>
      </section>
    )}
  </main>
</Base>
