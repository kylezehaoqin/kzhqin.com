---
import { SKILLS } from "../data/skills";

// compact: the home page shows the tools in muted text.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<ul class:list={["skills", { compact }]}>
  {SKILLS.map(({ domain, items }) => (
    <li class="dom">
      <h3>{domain}</h3>
      <ul class="items">{items.map((it) => <li>{it}</li>)}</ul>
    </li>
  ))}
</ul>
