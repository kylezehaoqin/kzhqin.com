---
import { SKILLS } from "../data/skills";

// compact: the home page shows one line per domain with its first 4 items.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<ul class:list={["skills", { compact }]}>
  {SKILLS.map(({ domain, items }) => (
    <li class="dom">
      <h3>{domain}</h3>
      <ul class="items">{(compact ? items.slice(0, 4) : items).map((it) => <li>{it}</li>)}</ul>
    </li>
  ))}
</ul>
