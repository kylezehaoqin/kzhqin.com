<div class="overlay" id="overlay" hidden></div>
<div class="picker" id="picker" role="dialog" aria-modal="true" aria-label="Find" hidden>
  <div class="pane">
    <span class="title">Find</span>
    <div class="tabs" id="finder-tabs" role="tablist" aria-label="Scope">
      {["All", "Projects", "Notes", "Pages"].map((t, i) => (
        <button type="button" role="tab" data-tab={t} aria-selected={i === 0 ? "true" : "false"} aria-controls="finder-results" tabindex="-1">{t}</button>
      ))}
    </div>
    <div class="prompt">
      <span aria-hidden="true">:</span>
      <input id="finder-q" type="text" autocomplete="off" spellcheck="false" aria-label="Search pages, projects, notes, and commands" aria-controls="finder-results" placeholder="pages, projects, notes, commands…" />
      <span class="count" id="finder-count"></span>
      <span class="fmode" id="finder-mode" data-m="INSERT" aria-hidden="true">INSERT</span>
    </div>
    <ul class="results" id="finder-results" role="listbox" aria-label="Results" tabindex="0"></ul>
  </div>
  <div class="pane preview" id="finder-preview"><span class="title">Preview</span></div>
</div>
