---
import { EMAIL } from "../data/contact";
const sha = (import.meta.env.PUBLIC_SHA ?? "").slice(0, 7) || "local";
const year = new Date().getFullYear();
---
<footer class="foot">
  <span>© {year} Kyle Qin · <span class="mail">{EMAIL}</span></span>
  <span>deployed <code>{sha}</code><span class="kbd-hint"> · try <kbd>:</kbd></span></span>
</footer>
