---
import { hasNotes } from "../lib/content";
interface Props { current: string; slug?: string }
const { current, slug } = Astro.props;
const section = current === "project" ? "projects" : "notes";
const bufs = [
  { name: "home", href: "/" },
  { name: "projects", href: "/projects" },
  ...((await hasNotes()) ? [{ name: "notes", href: "/notes" }] : []), // the numbers 1-5 follow this list
  { name: "about", href: "/about" },
  ...(slug ? [{ name: slug, href: `/${section}/${slug}` }] : []),
];
const active = slug ?? current;
---
<div class="sl" id="statusbar">
  <span class="pl mode" id="mode" data-m="NORMAL" aria-hidden="true">NORMAL</span>
  <div class="bufs">
    {bufs.map((b, i) => <a class="buf" href={b.href} aria-current={b.name === active ? "page" : undefined}>{i + 1} {b.name}</a>)}
  </div>
  <span class="pend" id="pending" aria-hidden="true"></span>
  <span class="grow"></span>
  <span class="pr blue hide-sm" id="clock" aria-label="Kyle's local time in the Bay Area">Bay Area</span>
  <span class="pr orange" id="pos" aria-hidden="true">Top</span>
</div>
