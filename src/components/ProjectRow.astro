---
import type { Project } from "../lib/content";
interface Props { project: Project }
const { id, data: { name, year, tags, summary } } = Astro.props.project;
---
<li>
  <a class="row nav-item" href={`/projects/${id}`}>
    <span class="yr">{year}</span>
    <h3>{name}</h3>
    <span class="tg">{tags.join(" · ")}</span>
    <p>{summary}</p>
  </a>
</li>
