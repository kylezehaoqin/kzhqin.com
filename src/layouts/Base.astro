---
import "@fontsource/nunito/600.css";
import "@fontsource/nunito/700.css";
import "@fontsource/nunito/800.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StatusBar from "../components/StatusBar.astro";
import Finder from "../components/Finder.astro";
import WhichKey from "../components/WhichKey.astro";
import { hasNotes } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  current: "home" | "projects" | "notes" | "about" | "note" | "project" | "404";
  slug?: string; // on a note or project page: its id, shown as an extra buffer
  type?: "website" | "article";
  src?: string; // repo-relative source file, for ␣gB
  ext?: string; // external link for gx on a detail page
}
const {
  title,
  description = "Kyle Qin, software engineer in the Bay Area. I've shipped production apps for education and e-commerce clients.",
  current,
  slug,
  type = "website",
  src,
  ext,
} = Astro.props;
const DEFAULT_SRC: Record<string, string> = {
  home: "src/pages/index.astro", projects: "src/pages/projects.astro", notes: "src/pages/notes/index.astro",
  about: "src/pages/about.mdx", "404": "src/pages/404.astro",
};
const source = src ?? DEFAULT_SRC[current] ?? "";
const fullTitle = title ? `${title} · Kyle Qin` : "Kyle Qin";
// build.format "file" makes the path /projects.html; the public URL is /projects (as in the sitemap).
const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
const canonical = current === "404" ? null : new URL(cleanPath, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(await hasNotes()) && <link rel="alternate" type="application/rss+xml" title="Kyle Qin: notes" href="/rss.xml" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kyle Qin, software engineer: full-stack applications and data systems." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply a saved theme, accent, and key state (status-bar colors) before first paint, so there is no flash.
      try {
        var t = localStorage.getItem("theme"), a = localStorage.getItem("accent");
        if (t === "paper") document.documentElement.dataset.theme = "light";
        if (t === "night") document.documentElement.dataset.theme = "dark";
        if (a === "signal") document.documentElement.dataset.accent = "signal";
        if (localStorage.getItem("keys-armed") === "1") document.documentElement.dataset.keys = "armed";
      } catch (e) {}
    </script>
  </head>
  <body data-page={current} data-src={source} data-ext={ext}>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="dots" aria-hidden="true"></canvas>
    <div class="layer">
      <Nav current={current} />
      <div class="wrap">
        <slot />
        <Footer />
      </div>
    </div>
    <StatusBar current={current} slug={slug} />
    <Finder />
    <WhichKey />
    <div class="notify" id="msg" role="status" aria-live="polite"></div>
    <div class="sr-only" id="sel-msg" aria-live="polite"></div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
