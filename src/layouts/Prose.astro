---
// Layout for Markdown/MDX pages in src/pages (about.mdx).
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} current={frontmatter.current ?? "about"}>
  <main class="page">
    <div class="page-h"><h1>{frontmatter.title}</h1></div>
    <div class="prose"><slot /></div>
  </main>
</Base>
